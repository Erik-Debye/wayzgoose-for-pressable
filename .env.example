# ---- Required ----

# The domain Caddy serves the dashboard on. Point its DNS at this server first.
WAYZGOOSE_DOMAIN=wayzgoose.example.com

# Dashboard password, at least 12 characters.
WAYZGOOSE_PASSWORD=change-me-to-something-long

# Encrypts the Pressable secret at rest. Generate with:  openssl rand -hex 32
# Keep it; without it the stored credentials can't be read after a restart.
WAYZGOOSE_SECRET_KEY=

# ---- Optional ----

# Pressable API application. Either put them here or enter them once in the
# dashboard's Settings (then stored encrypted in the data volume).
PRESSABLE_CLIENT_ID=
PRESSABLE_CLIENT_SECRET=

# Webhooks, used on first start if the dashboard has none yet.
WAYZGOOSE_WEBHOOK_URL=
WAYZGOOSE_USER_WEBHOOK_URL=

# Lets scripts call the API with "Authorization: Bearer <token>" and no login.
WAYZGOOSE_API_TOKEN=

# Timezone for the nightly backup time in Settings.
TZ=Europe/Berlin
